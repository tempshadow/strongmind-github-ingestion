# Database configuration
PGHOST=db
PGPORT=5432
PGUSER=strongmind_ingestion
PGPASSWORD=password
PGDATABASE=strongmind_ingestion_dev

# Rails environment
RAILS_ENV=development
LOG_LEVEL=info

# GitHub Events API
GITHUB_EVENTS_URL=https://api.github.com/events

# Ingestion runner
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10

# Requests held back from enrichment so the next cycle can always afford the feed
RATE_LIMIT_RESERVE=10

# Resilience
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
